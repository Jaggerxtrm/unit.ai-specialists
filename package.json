{
  "name": "@jaggerxtrm/specialists",
  "version": "3.21.6",
  "description": "Specialists \u2014 Pi-based orchestration runtime exposing the single use_specialist MCP tool plus CLI workflows for .specialist.json definitions.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xtrm-dev/specialists.git"
  },
  "homepage": "https://github.com/xtrm-dev/specialists#readme",
  "bugs": {
    "url": "https://github.com/xtrm-dev/specialists/issues"
  },
  "main": "dist/index.js",
  "types": "dist/types/lib.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/types/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/lib.js",
    "dist/types/",
    "dist/asset-contract.json",
    "bin/install.js",
    "scripts/generate-release-attestation.mjs",
    "config/specialists/",
    "config/mandatory-rules/",
    "config/skills/",
    "config/catalog/",
    "config/nodes/",
    "config/hooks/",
    "plugins/substrate/",
    "config/pi-extensions/",
    "config/pi-extensions/specialist-subagents/",
    "config/presets.json",
    "docs/overrides-guide.md",
    "CHANGELOG.md",
    "LICENSE",
    "!config/benchmarks/",
    "!config/skills/**/evals/",
    "!config/skills/**/evals/**"
  ],
  "bin": {
    "specialists": "dist/index.js",
    "sp": "dist/index.js",
    "install": "bin/install.js"
  },
  "scripts": {
    "build": "bun run generate:contract && bun build src/index.ts --target=bun --outfile=dist/index.js && bun build src/lib.ts --target=node --format=esm --outfile=dist/lib.js && tsc --emitDeclarationOnly --declaration --outDir dist/types && node scripts/postprocess-build.mjs",
    "dev": "bun run src/index.ts",
    "start": "bun dist/index.js",
    "lint": "tsc --noEmit",
    "test": "bun --bun vitest run",
    "test:quarantined": "timeout 480s env SPECIALISTS_TEST_QUARANTINED=1 bun --bun vitest run",
    "test:bun": "bun test tests/unit/specialist/observability-sqlite.test.ts tests/unit/specialist/observability-sqlite-pr-refresh.test.ts tests/unit/specialist/observability-db.test.ts tests/unit/cli/db.test.ts",
    "test:watch": "bun --bun vitest",
    "test:coverage": "bun --bun vitest run --coverage",
    "test:supervisor": "bun --bun vitest run tests/unit/specialist/supervisor.test.ts --no-file-parallelism",
    "benchmark:executor": "node scripts/run-executor-benchmark.mjs",
    "generate:contract": "node scripts/generate-asset-contract.mjs",
    "release:attest": "node scripts/generate-release-attestation.mjs",
    "changelog": "node scripts/changelog-update.mjs",
    "changelog:check": "node scripts/changelog-update.mjs --check",
    "preversion": "bun run changelog",
    "version": "node scripts/changelog-update.mjs --tag v$npm_package_version && bun run build && git add CHANGELOG.md dist/",
    "typecheck:tests": "tsc -p tsconfig.test.json"
  },
  "keywords": [
    "omnispecialist",
    "mcp",
    "model-context-protocol",
    "ai-orchestration",
    "gemini",
    "cursor",
    "droid",
    "smart-workflows",
    "circuit-breaker",
    "multi-model-ai"
  ],
  "author": "",
  "license": "MIT",
  "_runtime_prerequisites": {
    "xtrm-tools": {
      "required": true,
      "scope": "runtime",
      "reason": "specialists init requires xt CLI and .xtrm/ managed by xtrm-tools"
    }
  },
  "dependencies": {
    "@earendil-works/pi-tui": "0.75.5",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@modelcontextprotocol/server": "2.0.0",
    "hono": "4.12.32",
    "qs": "6.15.2",
    "yaml": "2.9.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "4.1.7",
    "tsx": "4.22.3",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.7"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.2",
    "hono": "4.12.32",
    "ip-address": "^10.2.0",
    "path-to-regexp": "^8.4.0",
    "qs": "6.15.2"
  }
}
